<?xml version="1.0" encoding="utf-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- Preset slots as exactly six JSON entries: indexes 0-2 are the Built-ins
         (50/10, 25/5, 45/15) and are re-seeded if a hand-edit removes them;
         indexes 3-5 are user presets, null = empty slot. Edited in the popup
         card (SPEC-002); the card never writes Built-in entries. -->
    <entry name="presets" type="String">
      <default>[{"label":"50/10","workMin":50,"breakMin":10},{"label":"25/5","workMin":25,"breakMin":5},{"label":"45/15","workMin":45,"breakMin":15},null,null,null]</default>
    </entry>

    <!-- Index of the starred Default Preset (0-5), started by Enable. Any slot
         may carry it; 0 is the fallback for empty/out-of-range stars. -->
    <entry name="defaultPreset" type="Int">
      <default>0</default>
    </entry>

    <!-- Desk Reminder: auxiliary posture countdown that runs only during Work
         Blocks and raises the Desk Overlay on expiry. -->
    <entry name="deskReminderEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="deskReminderMinutes" type="Int">
      <default>30</default>
    </entry>

    <!-- Presence-driven auto-start (SPEC-003): after this many unlocked
         minutes with no timing phase, start the Default Preset. The machine
         clamps the window to 1-60 and falls back to 5 on junk. -->
    <entry name="autoStartEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="autoStartMinutes" type="Int">
      <default>5</default>
    </entry>

    <!-- Cycle length: every Nth Work Block's Break is a Large Break. Default 4. -->
    <entry name="cycleLength" type="Int">
      <default>4</default>
    </entry>

    <!-- Machine state snapshot (phase, deadline, preset, completedBlocks, cycleLength,
         pendingBreak, largeBreak, deskDeadline, deskDue, paused, pausedRemainingMs,
         deskPausedRemainingMs, autoStartArmed) written on every state change;
         wall-clock restore on load. Presence and the raw lock state are never
         persisted. -->
    <entry name="stateSnapshot" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
